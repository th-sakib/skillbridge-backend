model Availability {
  id             String    @id @default(uuid())
  tutorProfileId String
  day            DayOfWeek
  startMinute    Int
  endMinute      Int

  tutor TutorProfiles @relation(fields: [tutorProfileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorProfileId])
  @@index([day])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
